FLUX2_MODEL_PATH=/absolute/path/to/FLUX.2-klein-9B
FLUX2KLEIN_API_KEY=replace-with-a-long-random-secret
FLUX2KLEIN_CONDA_ENV=flux2klein
# Set this instead of FLUX2KLEIN_CONDA_ENV when using an environment path.
# FLUX2KLEIN_CONDA_PREFIX=/absolute/path/to/conda/envs/flux2klein
# FLUX2KLEIN_CONDA_EXE=/absolute/path/to/conda/bin/conda
CUDA_VISIBLE_DEVICES=0
FLUX2KLEIN_HOST=127.0.0.1
FLUX2KLEIN_PORT=8036
FLUX2KLEIN_GPU_MEMORY_GB=40
